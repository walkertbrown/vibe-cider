{
  "name": "trace-press",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "proof": "node scripts/proof.mjs",
    "sample": "node scripts/sample.mjs",
    "ink": "node test/inkcheck.mjs",
    "build": "rm -rf public/js && esbuild src/ui/main.js src/ui/paper-page.js src/ui/name-page.js --bundle --minify --format=esm --target=es2020 --splitting --outdir=public/js",
    "deploy": "npm run build && wrangler deploy",
    "traffic": "node scripts/traffic.mjs",
    "indexnow": "node scripts/indexnow.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@tabler/icons": "^3.48.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.55.0",
    "pngjs": "^7.0.0",
    "wrangler": "^4.131.0"
  }
}
